<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvScannerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Identificación de Residuos"
        android:textColor="?attr/colorPrimary"
        android:textAppearance="@style/TextAppearance.App.TitleLarge"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Tarjeta de escaneo QR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCamera"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvScannerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_scan"
                app:tint="?attr/colorOnPrimaryContainer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Toca para escanear código QR"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvManualClasif"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="O selecciona la clasificación manual:"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textAppearance="@style/TextAppearance.App.LabelSmall"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/cardCamera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botones de clasificación manual -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPeligroso"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="Químicos"
        android:textColor="?attr/colorOnError"
        app:backgroundTint="?attr/colorError"
        app:cornerRadius="12dp"
        android:layout_marginTop="16dp"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvManualClasif"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBiomedico"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="Plásticos Peligrosos"
        android:textColor="?attr/colorOnTertiary"
        app:backgroundTint="?attr/colorTertiary"
        app:cornerRadius="12dp"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnPeligroso"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIndustrial"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="Cartón Industrial"
        android:textColor="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="12dp"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnBiomedico"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
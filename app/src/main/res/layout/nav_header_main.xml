<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="176dp"
    android:background="@drawable/bg_login_header"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/ThemeOverlay.Material3.Dark">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="Perfil"
        android:src="@drawable/ic_profile"
        android:tint="?attr/colorOnPrimary" />

    <TextView
        android:id="@+id/tvDrawerName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Nombre Apellido"
        android:textAppearance="@style/TextAppearance.App.TitleLarge"
        android:textColor="?attr/colorOnPrimary" />

    <TextView
        android:id="@+id/tvDrawerEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="correo@ecolim.com"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textColor="?attr/colorSecondaryContainer" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">

    <!-- Encabezado con Saludo -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola, Operario"
        android:textAppearance="@style/TextAppearance.App.TitleLarge"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resumen de tu turno actual"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp"/>

    <!-- Tarjetas de KPIs en Grid -->
    <LinearLayout
        android:id="@+id/llKpis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvDate">

        <!-- Tarjeta de Peso -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_recycle"
                    app:tint="?attr/colorOnPrimaryContainer"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PESO TOTAL"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimaryContainer"/>

                <TextView
                    android:id="@+id/tvTotalPeso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textSize="32sp"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="kg"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textColor="?attr/colorOnPrimaryContainer"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Volumen -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="20dp"
            app:strokeWidth="0dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_truck"
                    app:tint="?attr/colorOnSecondaryContainer"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOLUMEN TOTAL"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSecondaryContainer"/>

                <TextView
                    android:id="@+id/tvTotalVolumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textSize="32sp"
                    android:fontFamily="@font/manrope"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:layout_marginTop="4dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="m³"
                    android:textAppearance="@style/TextAppearance.App.LabelSmall"
                    android:textColor="?attr/colorOnSecondaryContainer"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Estado de Sincronización -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSyncStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutline"
        app:layout_constraintTop_toBottomOf="@id/llKpis">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivSyncIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_sync"
                app:tint="?attr/colorSecondary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvPendingCountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado de red"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toTopOf="@id/ivSyncIcon"
                app:layout_constraintStart_toEndOf="@id/ivSyncIcon"
                android:layout_marginStart="16dp"/>

            <TextView
                android:id="@+id/tvPendingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 registros pendientes"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textColor="?attr/colorSecondary"
                app:layout_constraintTop_toBottomOf="@id/tvPendingCountTitle"
                app:layout_constraintStart_toEndOf="@id/ivSyncIcon"
                android:layout_marginStart="16dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón Principal Flotante (Extendido) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSyncNow"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="32dp"
        android:text="SINCRONIZAR DATOS"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_sync"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="16dp">

    <!-- Encabezado con Saludo -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola, Operario"
        android:textAppearance="@style/TextAppearance.App.TitleLarge"
        android:textColor="?attr/colorPrimary"
        android:contentDescription="Mensaje de bienvenida"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resumen de tu turno actual"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:contentDescription="Subtítulo del resumen"
        app:layout_constraintTop_toBottomOf="@id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="4dp"/>

    <!-- Tarjetas de KPIs en Grid -->
    <LinearLayout
        android:id="@+id/llKpis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvDate">

        <!-- Tarjeta de Peso -->
        <com.example.android.ui.components.StatusCardView
            android:id="@+id/cardTotalPeso"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardTitle="PESO TOTAL"
            app:cardUnit="kg"
            app:cardIcon="@drawable/ic_recycle"
            app:cardTintColor="?attr/colorOnPrimaryContainer"
            android:contentDescription="Tarjeta de peso total recolectado"/>

        <!-- Tarjeta de Volumen -->
        <com.example.android.ui.components.StatusCardView
            android:id="@+id/cardTotalVolumen"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardTitle="VOLUMEN TOTAL"
            app:cardUnit="m³"
            app:cardIcon="@drawable/ic_truck"
            app:cardTintColor="?attr/colorOnSecondaryContainer"
            android:contentDescription="Tarjeta de volumen total recolectado"/>

    </LinearLayout>

    <!-- Estado de Sincronización -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSyncStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutline"
        app:layout_constraintTop_toBottomOf="@id/llKpis"
        android:contentDescription="Estado actual de sincronización">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivSyncIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_sync"
                app:tint="?attr/colorSecondary"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/tvPendingCountTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado de red"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintTop_toTopOf="@id/ivSyncIcon"
                app:layout_constraintStart_toEndOf="@id/ivSyncIcon"
                android:layout_marginStart="16dp"/>

            <TextView
                android:id="@+id/tvPendingCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 registros pendientes"
                android:textAppearance="@style/TextAppearance.App.BodyMedium"
                android:textColor="?attr/colorSecondary"
                app:layout_constraintTop_toBottomOf="@id/tvPendingCountTitle"
                app:layout_constraintStart_toEndOf="@id/ivSyncIcon"
                android:layout_marginStart="16dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón Principal Flotante (Extendido) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSyncNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:layout_marginBottom="32dp"
        android:text="SINCRONIZAR DATOS"
        android:textAppearance="@style/TextAppearance.App.BodyMedium"
        android:textStyle="bold"
        android:contentDescription="Sincronizar datos con el servidor"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_sync"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>